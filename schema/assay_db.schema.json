{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "assay_db.schema.json",
 "title": "Assay Builder database (compiled)",
 "description": "What docs/assay_db.json must contain. Source of truth is the CSV tables in data/; tools/build_db.py checks them and writes this structure.",
 "type": "object",
 "required": [
  "meta",
  "config",
  "function_classes",
  "assays",
  "kits",
  "usage_stats",
  "citations"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "schema_version",
    "built_on",
    "counts"
   ],
   "properties": {
    "schema_version": {
     "type": "string",
     "description": ""
    },
    "built_on": {
     "type": "string",
     "description": "date the file was built"
    },
    "last_curated": {
     "type": [
      "string",
      "null"
     ],
     "description": "most recent reviewed_on date; shown in the app header"
    },
    "counts": {
     "type": "object"
    },
    "includes_example_data": {
     "type": "boolean",
     "description": "true only for demo builds; the app must show an EXAMPLE banner"
    }
   }
  },
  "config": {
   "type": "object",
   "description": "Thresholds shown to the user in the Definitions panel",
   "properties": {
    "prevalence": {
     "type": "object",
     "properties": {
      "weights": {
       "type": "object",
       "properties": {
        "campaigns": {
         "type": "number"
        },
        "literature": {
         "type": "number"
        }
       }
      },
      "levels": {
       "type": "array",
       "description": "[level, minimum score] from highest to lowest",
       "items": {
        "type": "array"
       }
      },
      "min_campaigns_for_confidence": {
       "type": "integer"
      },
      "note": {
       "type": "string",
       "description": ""
      }
     }
    },
    "coverage": {
     "type": "object",
     "properties": {
      "full": {
       "type": "number"
      },
      "partial": {
       "type": "number"
      }
     }
    },
    "plate_estimate": {
     "type": "object"
    }
   }
  },
  "function_classes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "class_id",
     "label"
    ],
    "properties": {
     "class_id": {
      "type": "string",
      "description": "stable id used by assays"
     },
     "label": {
      "type": "string",
      "description": ""
     },
     "ec_prefixes": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "UniProt EC number prefixes"
     },
     "keywords": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "UniProt keywords"
     },
     "go_terms": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "GO function substrings"
     },
     "domain_patterns": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "words matched against UniProt domain/region names"
     },
     "needs_domain": {
      "type": "boolean"
     },
     "modality": {
      "type": [
       "string",
       "null"
      ],
      "description": "set only for classes switched on by a project type (degrader, autophagy, rna_target)"
     },
     "excludes": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "class_ids this class cancels"
     },
     "notes": {
      "type": "string",
      "description": ""
     }
    }
   }
  },
  "assays": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "entry_id",
     "assay_name",
     "classes",
     "assay_category",
     "scope",
     "role",
     "screening_suitability",
     "biological_relevance",
     "review"
    ],
    "properties": {
     "entry_id": {
      "type": "string",
      "description": "stable id, never reused"
     },
     "assay_name": {
      "type": "string",
      "description": ""
     },
     "classes": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "class_ids this assay applies to"
     },
     "assay_category": {
      "enum": [
       "biochemical_hts",
       "cell_functional",
       "biophysical_binding",
       "orthogonal_confirmation",
       "mechanistic_counterscreen"
      ]
     },
     "scope": {
      "enum": [
       "cell-free",
       "cell-based"
      ]
     },
     "role": {
      "enum": [
       "primary",
       "confirmation",
       "counterscreen"
      ]
     },
     "development_priority": {
      "type": "object",
      "properties": {
       "best": {
        "type": [
         "integer",
         "null"
        ]
       },
       "text": {
        "type": "string",
        "description": "as written, e.g. P2/P3"
       }
      }
     },
     "screening_suitability": {
      "type": "string",
      "enum": [
       "very_low",
       "low",
       "moderate",
       "high",
       "very_high"
      ]
     },
     "biological_relevance": {
      "type": "string",
      "enum": [
       "very_low",
       "low",
       "moderate",
       "high",
       "very_high"
      ]
     },
     "rating_notes": {
      "type": "string",
      "description": ""
     },
     "measures": {
      "type": "string",
      "description": ""
     },
     "readouts": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "detection technologies; use the same names as the term table"
     },
     "evidence_labels": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "function names used to count public campaigns"
     },
     "conditions": {
      "type": "string",
      "description": ""
     },
     "reagents": {
      "type": "string",
      "description": ""
     },
     "rationale": {
      "type": "string",
      "description": ""
     },
     "plate_formats": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "any of 96, 384, 1536; empty = not specified, app estimates from suitability"
     },
     "mechanism": {
      "type": "object",
      "properties": {
       "learn_more_url": {
        "type": [
         "string",
         "null"
        ],
        "description": "video or lesson; app hides the button when null"
       }
      }
     },
     "quality": {
      "type": "object",
      "description": "curated from the NIH Assay Guidance Manual; the app holds the wording for each code",
      "properties": {
       "qc_metric": {"type": ["string", "null"], "enum": ["hts", "hcs", "potency", null], "description": "hts: Z' >= 0.4 or SW >= 2; hcs: 0 < Z' <= 0.5 acceptable; potency: replicate MSR < 3"},
       "dmso_pct": {"type": ["string", "null"], "description": "curated starting point for final DMSO, a number (upper limit) or a range such as 1-2"},
       "interference": {"type": "array", "items": {"type": "string", "enum": ["luciferase", "fluorescence", "absorbance", "proximity", "aggregation", "thiol_redox", "cytotoxicity", "imaging", "label_free"]}}
      }
     },
     "sources": {
      "type": "array",
      "description": "literature for this assay (not vendor kits)",
      "items": {
       "type": "object",
       "required": [
        "doi"
       ],
       "properties": {
        "doi": {
         "type": "string",
         "description": ""
        },
        "title": {
         "type": "string",
         "description": ""
        },
        "year": {
         "type": "string",
         "description": ""
        },
        "journal": {
         "type": "string",
         "description": ""
        }
       }
      }
     },
     "review": {
      "type": "object",
      "properties": {
       "status": {
        "type": "string",
        "description": "draft or reviewed, free text"
       },
       "reviewer": {
        "type": [
         "string",
         "null"
        ]
       },
       "reviewed_on": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "kits": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kit_id",
     "vendor",
     "product",
     "applies_to_entries"
    ],
    "properties": {
     "kit_id": {
      "type": "string",
      "description": ""
     },
     "vendor": {
      "type": "string",
      "description": ""
     },
     "product": {
      "type": "string",
      "description": ""
     },
     "product_code": {
      "type": [
       "string",
       "null"
      ],
      "description": "only if seen on the vendor page"
     },
     "applies_to_entries": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "assay entry_ids"
     },
     "target_scope": {
      "type": "string",
      "description": "pan-class (...), many receptors, or gene symbols"
     },
     "format": {
      "type": "string",
      "description": "kit, service, cell line, instrument"
     },
     "readout": {
      "type": "string",
      "description": ""
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     },
     "verification": {
      "type": "object",
      "properties": {
       "status": {
        "type": "string",
        "description": "e.g. listing seen / unverified / confirmed on datasheet"
       },
       "last_checked": {
        "type": [
         "string",
         "null"
        ]
       },
       "source": {
        "type": "string",
        "description": ""
       }
      }
     }
    }
   }
  },
  "usage_stats": {
   "type": "object",
   "description": "How often an assay (or one readout / plate format of it) is used, as a compact table (schema 0.2). Each row is a list in the order of 'columns'. One row per assay x scope x stage x effect view (x readout or plate). docs/index.html expands rows back into objects.",
   "required": [
    "columns",
    "rows",
    "source_columns",
    "sources"
   ],
   "properties": {
    "columns": {
     "const": [
      "entry_id",
      "scope_type",
      "scope_id",
      "stage",
      "effect",
      "readout",
      "plate",
      "total",
      "classifiable",
      "using",
      "lit_total",
      "lit_using",
      "score",
      "level",
      "low_confidence",
      "source"
     ],
     "description": "entry_id; scope_type (gene | function_class); scope_id (gene symbol or class_id); stage; effect (any | inhibition | activation | inhibition_labeled | activation_with_unspecified); readout (technology name or null); plate (96 | 384 | 1536 | low or null); total = unique campaigns found; classifiable = denominator; using = numerator; lit_total, lit_using = literature counts or null; score = weighted share 0-1 or null; level = very_low..very_high or null; low_confidence = 1 when classifiable < min_campaigns_for_confidence; source = index into 'sources'"
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16
     }
    },
    "source_columns": {
     "const": [
      "name",
      "query",
      "retrieved_on",
      "method_version",
      "notes"
     ]
    },
    "sources": {
     "type": "array",
     "description": "Shared provenance text, stored once. method_version 'example' marks illustrative numbers.",
     "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  },
  "citations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "doi"
    ],
    "properties": {
     "doi": {
      "type": "string",
      "description": ""
     },
     "pmid": {
      "type": "string",
      "description": ""
     },
     "title": {
      "type": "string",
      "description": ""
     },
     "year": {
      "type": "string",
      "description": ""
     },
     "journal": {
      "type": "string",
      "description": ""
     },
     "authors": {
      "type": "string",
      "description": ""
     },
     "type": {
      "type": "string",
      "description": "method paper, review, vendor note"
     },
     "url": {
      "type": "string",
      "description": ""
     },
     "fetched_on": {
      "type": "string",
      "description": ""
     }
    }
   }
  }
 }
}